{
  "name": "roleplay-api",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@8.11.0",
  "engines": {
    "node": "17.9.1",
    "npm": "8.11.0"
  },
  "scripts": {
    "dev": "node ace serve --watch",
    "build": "node ace build --production",
    "start": "node server.js",
    "test": "node ace test",
    "test:legacy": "node -r @adonisjs/assembler/build/register japaFile.ts",
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write ."
  },
  "eslintConfig": {
    "extends": [
      "plugin:adonis/typescriptApp",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error"
      ]
    }
  },
  "eslintIgnore": [
    "build"
  ],
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "useTabs": false,
    "quoteProps": "consistent",
    "bracketSpacing": true,
    "arrowParens": "always",
    "printWidth": 100
  },
  "devDependencies": {
    "@adonisjs/assembler": "5.9.6",
    "@japa/preset-adonis": "1.2.0",
    "@japa/runner": "2.5.1",
    "@types/node": "17.0.45",
    "@types/proxy-addr": "2.0.3",
    "@types/source-map-support": "0.5.10",
    "@types/supertest": "2.0.12",
    "adonis-preset-ts": "2.1.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-adonis": "2.1.1",
    "eslint-plugin-prettier": "4.2.1",
    "execa": "5.1.1",
    "get-port": "5.1.1",
    "japa": "4.0.0",
    "pino-pretty": "7.6.1",
    "prettier": "2.8.8",
    "sqlite3": "5.1.6",
    "supertest": "6.3.3",
    "typescript": "4.6.4"
  },
  "dependencies": {
    "@adonisjs/core": "5.9.0",
    "@adonisjs/lucid": "18.3.0",
    "@adonisjs/repl": "3.1.11",
    "luxon": "3.1.0",
    "proxy-addr": "2.0.7",
    "reflect-metadata": "0.1.13",
    "source-map-support": "0.5.21"
  }
}
